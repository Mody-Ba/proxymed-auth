# Modele du fichier local .env.properties (a creer a la racine du projet, a cote de pom.xml).
#   cp .env.properties.example .env.properties
# puis remplacer les valeurs ci-dessous. .env.properties est ignore par Git : il ne doit
# jamais etre commite. TOUTES les valeurs de ce modele sont fictives.

# Base PostgreSQL proxymed_auth (utilisateur facultatif : "proxymed" par defaut)
PROXYMED_DB_USERNAME=proxymed
PROXYMED_DB_PASSWORD=mot-de-passe-de-la-base

# Secret du badge (JWT) : au moins 32 caracteres, aleatoire.
# Pour en generer un : openssl rand -base64 48
PROXYMED_JWT_SECRET=remplacer-par-un-secret-aleatoire-d-au-moins-32-caracteres

# Premier administrateur : cree au demarrage seulement s'il n'existe aucun compte ADMIN.
# Ces deux lignes peuvent etre retirees une fois l'administrateur cree.
PROXYMED_ADMIN_EMAIL=admin@exemple.com
PROXYMED_ADMIN_PASSWORD=mot-de-passe-administrateur

# Serveur SMTP pour l'envoi des codes d'inscription (STARTTLS, port 587 en general).
# L'expediteur des emails est PROXYMED_MAIL_USERNAME.
PROXYMED_MAIL_HOST=smtp.exemple.com
PROXYMED_MAIL_PORT=587
PROXYMED_MAIL_USERNAME=no-reply@exemple.com
PROXYMED_MAIL_PASSWORD=mot-de-passe-smtp
